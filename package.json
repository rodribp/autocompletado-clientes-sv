{
  "name": "autocompletado-clientes-sv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Extensión de Chrome que guarda tus clientes localmente y rellena el receptor de facturas y créditos fiscales en admin.factura.gob.sv.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --tests && node --test \".tmp/tests/**/*.test.mjs\"",
    "zip": "node scripts/build.mjs --zip",
    "clean": "rm -rf dist .tmp *.zip"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3"
  }
}
